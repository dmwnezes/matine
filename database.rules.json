{
  "rules": {
    "salas": {
      "$sala": {
        ".read": "auth != null",
        ".write": "auth != null && !newData.exists() && !data.child('pessoas').exists() && root.child('vazias/' + $sala).isNumber() && root.child('vazias/' + $sala).val() < now - 600000",
        "info": {
          ".write": "auth != null && (!data.exists() || data.child('dono').val() === auth.uid || !root.child('salas/' + $sala + '/pessoas/' + data.child('dono').val()).exists())",
          ".validate": "newData.hasChild('dono') && (newData.child('dono').val() === auth.uid || root.child('salas/' + $sala + '/pessoas/' + newData.child('dono').val()).exists()) && newData.child('link').isString() && newData.child('link').val().length <= 2000"
        },
        "estado": {
          ".write": "auth != null && root.child('salas/' + $sala + '/info').exists()",
          ".validate": "newData.hasChildren(['tocando', 'pos', 'em', 'por']) && newData.child('tocando').isBoolean() && newData.child('pos').isNumber() && newData.child('pos').val() >= 0 && newData.child('em').isNumber() && newData.child('em').val() <= now + 15000 && newData.child('por').val() === auth.uid"
        },
        "ponto": {
          ".write": "auth != null && root.child('salas/' + $sala + '/info').exists()",
          ".validate": "newData.hasChildren(['pos', 'em']) && newData.child('pos').isNumber() && newData.child('em').isNumber()"
        },
        "pessoas": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "!newData.exists() || (newData.child('nome').isString() && newData.child('nome').val().length <= 24)"
          }
        },
        "chat": {
          "$msg": {
            ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid",
            ".validate": "newData.child('texto').isString() && newData.child('texto').val().length <= 500 && (!newData.child('img').exists() || (newData.child('img').isString() && newData.child('img').val().length <= 300000 && newData.child('img').val().beginsWith('data:image/jpeg;base64,')))",
            "abertas": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid && data.parent().parent().exists()",
                ".validate": "newData.isString() && newData.val().length <= 24"
              }
            }
          }
        },
        "reacoes": {
          "$r": {
            ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid",
            ".validate": "newData.child('e').isString() && newData.child('e').val().length <= 8"
          }
        }
      }
    },
    "listas": {
      "$lista": {
        ".read": "auth != null && $lista.length === 16",
        "filmes": {
          "$f": {
            ".write": "auth != null && $lista.length === 16",
            ".validate": "newData.hasChildren(['link', 'titulo', 'em']) && newData.child('link').isString() && newData.child('link').val().length <= 2000 && newData.child('titulo').isString() && newData.child('titulo').val().length <= 120 && newData.child('em').isNumber() && (!newData.child('visto').exists() || newData.child('visto').isNumber())"
          }
        }
      }
    },
    "vazias": {
      "$sala": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.isNumber() && newData.val() >= now - 60000"
      }
    }
  }
}
